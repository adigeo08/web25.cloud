{
    "env": {
        "browser": true,
        "es2021": true,
        "serviceworker": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "module"
    },
    "globals": {
        "WebTorrent": "readonly",
        "DOMPurify": "readonly",
        "PublicKeyCredential": "readonly",
        "Buffer": "readonly",
        "module": "readonly"
    },
    "rules": {
        "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
        "no-console": "off",
        "no-empty": ["error", { "allowEmptyCatch": true }],
        "prefer-const": "warn",
        "no-var": "error",
        "eqeqeq": ["error", "always"],
        "curly": ["error", "multi-line"]
    }
}
